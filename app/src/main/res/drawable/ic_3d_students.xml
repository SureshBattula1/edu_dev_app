<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Ambient Shadow -->
    <path
        android:pathData="M28,108 C44,120 84,120 100,108 C112,98 108,86 92,86 C76,86 52,86 36,86 C20,86 16,98 28,108 Z"
        android:fillColor="#1F1E293B" />

    <!-- 3D Student Cap / Mortarboard Body -->
    <path
        android:pathData="M64,28 L112,48 L64,68 L16,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16" android:startY="28"
                android:endX="112" android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF312E81"/>
                <item android:offset="1.0" android:color="#FF1E1B4B"/>
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M16,48 L64,68 L64,74 L16,54 Z"
        android:fillColor="#FF1E1B4B" />
    <path
        android:pathData="M64,68 L112,48 L112,54 L64,74 Z"
        android:fillColor="#FF312E81" />

    <!-- Cap Skull Cap Base -->
    <path
        android:pathData="M40,58 C40,78 88,78 88,58 L88,72 C88,88 40,88 40,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40" android:startY="58"
                android:endX="88" android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF4338CA"/>
                <item android:offset="1.0" android:color="#FF3730A3"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tassel Ribbon & Gold Ornament -->
    <path
        android:pathData="M64,48 L100,64 L100,88 C96,92 104,92 100,88 Z"
        android:strokeColor="#FFFACC15"
        android:strokeWidth="4"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M96,86 A6,6 0 1,1 108,86 A6,6 0 1,1 96,86 Z"
        android:fillColor="#FFEAB308"/>

    <!-- Floating 3D Badge (Student Shield) -->
    <path
        android:pathData="M24,76 L48,68 L48,100 L24,92 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24" android:startY="68"
                android:endX="48" android:endY="100"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF10B981"/>
                <item android:offset="1.0" android:color="#FF047857"/>
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M32,80 L40,88 L40,76"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
